<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>WatchHandMod</AssemblyName>
    <RootNamespace>WatchHandMod</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618;CS0612</NoWarn>
    <!-- 发布版: 不生成调试符号, 避免把本机源码路径嵌进 dll -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CesiumLoader.SDK">
      <HintPath>..\..\tools\cesium-sdk\CesiumLoader.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AstralParty.Runtime.dll 内含 FairyGUI + GameLogic + UI + party.model/protocol 全部热更类型 -->
    <Reference Include="AstralParty.Runtime">
      <HintPath>..\..\extracted_dlls\AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\extracted_dlls\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\il2cpp_dump2\DummyDll\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf.Runtime">
      <HintPath>..\..\extracted_dlls\Google.Protobuf.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>..\..\extracted_dlls\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityWebRequestModule(DummyDll) 的重载解析需要框架版 System.Uri; 改用 WebClient, 不再需要 -->
  </ItemGroup>

</Project>
